{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GradePath course snapshot",
  "type": "object",
  "required": ["course_key", "course_name", "model", "target", "rule_source", "rules_status", "data_completeness", "categories", "assignments"],
  "properties": {
    "course_key": {"type": "string", "minLength": 1},
    "course_name": {"type": "string", "minLength": 1},
    "course_code": {"type": "string"},
    "model": {"enum": ["points", "weighted"]},
    "target": {"type": "number", "minimum": 0, "maximum": 100},
    "target_label": {"type": "string"},
    "rule_source": {"type": "string", "minLength": 1},
    "rules_status": {"enum": ["confirmed", "student_confirmed", "inferred", "unknown", "conflicting"]},
    "data_completeness": {"enum": ["complete", "likely_complete", "partial", "unknown"]},
    "positive_notifications": {"type": "boolean", "default": false},
    "source": {"type": "string"},
    "unsupported_rules": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "array", "items": {"type": "object", "required": ["rule", "value", "source_type", "source_reference", "status"], "properties": {"rule": {"type": "string"}, "value": {}, "source_type": {"type": "string"}, "source_reference": {"type": "string"}, "status": {"enum": ["confirmed", "student_confirmed", "inferred", "unknown", "conflicting"]}}}},
    "categories": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name", "weight"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "weight": {"type": "number", "minimum": 0, "maximum": 100}}}},
    "assignments": {"type": "array", "items": {"type": "object", "required": ["id", "name", "category", "points_possible", "score", "status"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "category": {"type": "string"}, "points_possible": {"type": ["number", "null"], "minimum": 0}, "score": {"type": ["number", "null"], "minimum": 0}, "status": {"enum": ["graded", "ungraded", "submitted", "missing", "late", "excused", "hidden", "not_due", "unavailable"]}, "increment": {"type": "number", "exclusiveMinimum": 0}, "source_reference": {"type": "string"}, "due_at": {"type": ["string", "null"]}}}}
  }
}
